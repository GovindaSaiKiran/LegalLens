# ==========================================
# LegalLens - Centralized Environment Config
# ==========================================

PORT=5000
AUTH_SECRET=your_jwt_auth_secret_here

# Legal AI Reasoning (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini Translation API
GEMINI_TRANSLATION_API_KEY=your_gemini_translation_api_key_here

# Gemini Voice API (STT / TTS)
GEMINI_VOICE_API_KEY=your_gemini_voice_api_key_here

# Centralized Google / Cloud Vision API
GOOGLE_API_KEY=your_google_api_key_here

# Firebase Web Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Target Jurisdiction
DEFAULT_JURISDICTION=india
