{
  "name": "legallens-platform",
  "version": "1.0.0",
  "description": "LegalLens - GenAI Legal Awareness Platform",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend",
    "start": "node backend/src/server.js",
    "dev:backend": "node --watch --watch-path=backend/src backend/src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "cd backend && npm install",
    "build": "cd backend && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1"
  }
}
