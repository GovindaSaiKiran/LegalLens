{
  "manifest_version": 3,
  "name": "LegalLens — Before You Agree",
  "version": "1.0.0",
  "description": "GenAI legal awareness companion. Detects consent checkboxes and explains data usage, renewals, and cancellations before you agree.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LegalLens Legal Awareness"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ]
}
